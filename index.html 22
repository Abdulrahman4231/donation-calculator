:root {
  --ink: #123126;
  --green: #086449;
  --muted: #526e60;
  --line: #d7e1db;
  --soft: #e3efe8;
  --summary-space: 150px;
}

* {
  box-sizing: border-box;
}

html {
  margin: 0;
  background: #edf4f9;
  -webkit-text-size-adjust: 100%;
  scroll-padding-bottom: var(--summary-space);
}

body {
  margin: 0;
  min-height: 100vh;
  min-height: 100dvh;
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Tahoma, Arial, sans-serif;
  background: #17392d;
  isolation: isolate;
  -webkit-tap-highlight-color: transparent;
}

body::before {
  content: "";
  position: fixed;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  background-image: 
    linear-gradient(#123a2b77, #123a2b66), 
    url("data:image/jpeg;base64,");
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}
